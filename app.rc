// Windows resources for WhisperScribe: the exe icon (Explorer, taskbar, Alt+Tab) and the
// version info shown in Task Manager / file properties.
#include <winver.h>

// "1" is the icon Explorer shows for the exe; "GLFW_ICON" is the name GLFW (and main.cpp)
// looks for when creating the window.
1         ICON "assets/icon.ico"
GLFW_ICON ICON "assets/icon.ico"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION 1,0,0,0
 PRODUCTVERSION 1,0,0,0
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
 FILESUBTYPE VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "FileDescription", "WhisperScribe"
            VALUE "ProductName", "WhisperScribe"
            VALUE "FileVersion", "1.0.0.0"
            VALUE "ProductVersion", "1.0.0.0"
            VALUE "InternalName", "whisper_scribe"
            VALUE "OriginalFilename", "whisper_scribe.exe"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
